#!/bin/sh
# Valida o padrão Conventional Commits

first_line=$(head -n1 "$1")

# Permite commits de merge gerados pelo Git
case "$first_line" in
  Merge*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,100}$'

if ! echo "$first_line" | grep -Eq "$pattern"; then
  echo "Mensagem fora do padrão Conventional Commits."
  echo "Formato: tipo(escopo): descrição"
  echo "Exemplo: feat(orders): add stock reservation"
  exit 1
fi